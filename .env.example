# ========================================================
# VARIABLES DE ENTORNO PARA NEXO-CITAS-API (Coolify)
# ========================================================

# --- GitHub Packages (OBLIGATORIO para el build) ---
# Credenciales para resolver nexo-core-spring (repo privado).
# En Coolify se definen como "Build Variables" o secrets del servicio.
GITHUB_ACTOR=
GITHUB_TOKEN=

# Puerto del Microservicio
SERVER_PORT=8085

# Configuración de Base de Datos PostgreSQL
# En Coolify el host "db" resuelve al sidecar Postgres del compose.
DB_HOST=db
DB_PORT=5432
DB_NAME=citas_db
DB_USER=nexo
DB_PASSWORD=nexo

# Integración transaccional por eventos (Outbox)
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000

# Integración sincrona con nexo-personal-api (Agenda Medica)
PERSONAL_SERVICE_URL=http://nexo-personal-api:8081

# Configuración de Niveles de Log (Opcional)
LOG_LEVEL_NEXO=DEBUG
LOG_LEVEL_HIBERNATE=INFO