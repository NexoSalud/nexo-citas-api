# ========================================================
# VARIABLES DE ENTORNO PARA NEXO-CITAS-API
# ========================================================
# Despliegue: la imagen se publica en GHCR (GitHub Actions)
# y Coolify solo la descarga. Este archivo documenta las
# variables de entorno del contenedor (runtime).

# --- CI (GitHub Actions, no para el contenedor) ---
# GH_TOKEN: PAT con read:packages/write:packages (resuelve
#   nexo-core-spring privado y publica en GHCR)
# GH_ACTOR: usuario del PAT (opcional, fallback = actor del workflow)

# Imagen a desplegar (para docker-compose)
CITAS_IMAGE_TAG=coolify

# Puerto del Microservicio
SERVER_PORT=8085

# Base de Datos PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_NAME=citas_db
DB_USER=nexo
DB_PASSWORD=nexo

# Integración transaccional por eventos (Outbox)
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000

# Integración sincrona con nexo-personal-api (Agenda Medica)
PERSONAL_SERVICE_URL=http://nexo-personal-api:8081

# Configuración de SSO Keycloak
KEYCLOAK_ENABLED=true
KEYCLOAK_HOST=https://nexoauth.app.goline.com.co
KEYCLOAK_REALM=nexo2.0
KEYCLOAK_CLIENT_ID=nexo-gateway-service
KEYCLOAK_CLIENT_SECRET=NexoGatewaySecret2026KeycloakServiceAccount

# Niveles de Log (Opcional)
LOG_LEVEL_NEXO=DEBUG
LOG_LEVEL_HIBERNATE=INFO